{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "deft-rewrite",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "www.michael-han.com/deft/api/*", "zone_name": "michael-han.com" },
    { "pattern": "michael-han.com/deft/api/*", "zone_name": "michael-han.com" }
  ],
  // 5 rewrites per minute per IP
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
  // Secret: DEFT_API_KEY (set with `npx wrangler secret put DEFT_API_KEY`)
}
